# Django Core Settings
SECRET_KEY=your-production-django-secret-key-at-least-50-random-chars
DEBUG=False
ALLOWED_HOSTS=itint.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://itint.onrender.com,http://localhost:8000
CORS_ALLOWED_ORIGINS=https://itint.onrender.com,http://localhost:8000

# Database Configuration (PostgreSQL on Render/Railway, SQLite fallback locally)
DATABASE_URL=postgresql://username:password@hostname:5432/itint_database

# Razorpay Gateway
RAZORPAY_KEY_ID=rzp_live_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourConfiguredWebhookSecretHere
RAZORPAY_CURRENCY=INR

# Security Overrides (optional)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
